# Environment
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# AI Provider Configuration
# Options: openai, ollama, huggingface, cohere, anthropic
AI_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# HuggingFace (if AI_PROVIDER=huggingface)
HUGGINGFACE_API_KEY=hf_your_key_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.1
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cohere (if AI_PROVIDER=cohere)
COHERE_API_KEY=your-cohere-key
COHERE_MODEL=command
COHERE_EMBEDDING_MODEL=embed-english-v3.0

# Anthropic (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Gemini (if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SIMILARITY_THRESHOLD=0.7
TOP_K=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=INFO
