# General
APP_NAME=RAG Study Assistant
API_PREFIX=/api
DEBUG=false

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# Supabase 
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_URL=your-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# Provider selection
# LLM_PROVIDER: openai | gemini
# EMBEDDING_PROVIDER: openai (fixed to 1536-dim schema for now)
# RERANK_PROVIDER: none | llm
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
RERANK_PROVIDER=none

# OpenAI (default stack)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Gemini (optional LLM provider)
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Retrieval
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_LEXICAL_TOP_K=20
RETRIEVAL_FINAL_TOP_K=8

# Chunking
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# Ingestion
ENABLE_ASYNC_INGESTION=true
WORKER_POLL_INTERVAL_SECONDS=1.0
MAX_UPLOAD_SIZE_BYTES=25000000

# Rate Limiting
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Feature flags
ENABLE_HIERARCHICAL_RAG=true
ENABLE_AGENTIC_RAG=false
ENABLE_DEBUG_ENDPOINTS=false

# Real integration tests (cost money / hits live services)
# RUN_REAL_INTEGRATION=1
# pytest -m integration tests/integration
