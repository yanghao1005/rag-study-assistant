APP_NAME=RAG Study Assistant Backend v5
API_PREFIX=/api
DEBUG=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

ENABLE_AGENTIC_RAG=false
ENABLE_HYBRID_RETRIEVAL=true
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_ASYNC_INGESTION=true
WORKER_POLL_INTERVAL_SECONDS=1.0
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_EXEMPT_PATHS=/api/health
ENABLE_ABUSE_PROTECTION=true
MAX_REQUEST_SIZE_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=25000000
BLOCKED_USER_AGENTS=sqlmap,nikto,nmap,masscan
ENABLE_TELEMETRY=false
OTEL_SERVICE_NAME=rag-study-assistant-backend-v5
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_METRICS_EXPORT_INTERVAL_MS=60000

LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
VECTOR_REPOSITORY_PROVIDER=supabase

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

DEBUG_ARTIFACTS_DIR=debug_artifacts
BENCHMARK_REPORTS_DIR=benchmark_reports
UPLOADS_DIR=uploads
